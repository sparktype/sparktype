---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../paths';

type Props = HTMLAttributes<'a'>;

const { href = '/', class: className, ...props } = Astro.props;
const logical = String(href);
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const stripped = Astro.url.pathname.startsWith(base)
	? Astro.url.pathname.slice(base.length)
	: Astro.url.pathname.replace(/^\//, '');
const current = `/${stripped}`.replace(/\/+/g, '/').replace(/\/$/, '') || '/';
const target = logical.replace(/\/$/, '') || '/';
const isActive = current === target || (target !== '/' && current.startsWith(`${target}/`));
---

<a href={withBase(logical)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
